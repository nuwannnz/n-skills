{
  "name": "scrumo-desktop",
  "version": "0.5.9",
  "description": "Desktop app for scrumo: business analysts and architects run spec-driven skills through their own Claude Code.",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "scrumo-desktop": "bin/scrumo-desktop.js"
  },
  "files": [
    "bin",
    "src/*.js",
    "src/*.cjs",
    "dist/renderer",
    "build/icon.png",
    "build/icon.icns",
    "build/icon.ico",
    "scripts/postinstall.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite build && electron .",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "prepack": "vite build",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js",
    "demo:setup": "node scripts/setup-demo.js",
    "smoke": "node scripts/smoke.js",
    "icons": "electron scripts/make-icons.js",
    "check": "node scripts/check.js && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "electron": "44.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwannnz/n-skills.git",
    "directory": "desktop"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/nuwannnz/n-skills/issues"
  },
  "homepage": "https://github.com/nuwannnz/n-skills/tree/main/desktop#readme",
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "immer": "11.1.18",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "zustand": "5.0.15"
  }
}
