{
  "name": "scrumo-desktop",
  "version": "0.1.0",
  "description": "Desktop app for scrumo: business analysts and architects run spec-driven skills through their own Claude Code.",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "scrumo-desktop": "bin/scrumo-desktop.js"
  },
  "files": [
    "bin",
    "src",
    "build/icon.png",
    "build/icon.icns",
    "build/icon.ico",
    "scripts/postinstall.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
