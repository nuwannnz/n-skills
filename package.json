{
  "name": "scrumo",
  "version": "0.1.0",
  "description": "Agent skills and a strict Markdown validator for agile engineering teams: spec-driven, with every document checked.",
  "keywords": [
    "agile",
    "scrum",
    "spec-driven",
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "validator",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwannnz/n-skills.git"
  },
  "bugs": {
    "url": "https://github.com/nuwannnz/n-skills/issues"
  },
  "homepage": "https://github.com/nuwannnz/n-skills#readme",
  "type": "module",
  "bin": {
    "scrumo": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "spec",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "rename": "node scripts/rename.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint:md": "markdownlint-cli2 --config spec/markdownlint.json \"*.md\" \"spec/**/*.md\" \"skills/**/*.md\" \"examples/**/*.md\"",
    "check": "npm run typecheck && npm run lint:md && npm test",
    "desktop": "npm start -w desktop",
    "check:desktop": "npm run check -w desktop"
  },
  "dependencies": {
    "markdownlint": "^0.41.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "desktop"
  ]
}
