    "postinstall": "node scripts/postinstall.js",
    "demo:setup": "node scripts/setup-demo.js",
    "smoke": "node scripts/smoke.js",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "marked": "12.0.2",
    "electron": "44.7.2"
  }
